e the NBR matrix.\n","    \"\"\"\n","  # Retrieve tokenized URL from STAC item\n","  url_nir = item.assets[\"B08\"].href\n","  url_swir = item.assets[\"B12\"].href\n","\n","  # Open the URLs and clip using EPSG:4326\n","  nir_clip = (rioxarray.open_rasterio(url_nir, masked=True).rio.clip_box(*bbox, crs=\"EPSG:4326\").load())\n","  swir_clip = (rioxarray.open_rasterio(url_swir, masked=True).rio.clip_box(*bbox, crs=\"EPSG:4326\").load())\n","\n","  # adjust SWIR (20m) ke NIR (10m)\n","  swir_resized =  swir_clip.rio.reproject_match(nir_clip, resampling=Resampling.bilinear)\n","\n","  # convert to float32\n","  nir_f = nir_clip.astype(\"float32\")\n","  swir_f = swir_resized.astype(\"float32\")\n","\n","  # Calculate NBR: (NIR - SWIR) / (NIR + SWIR)\n","  nbr = (nir_f - swir_f) / (nir_f + swir_f)\n","\n","  return nbr"],"metadata":{"id":"2b9EdT8AKOQa","executionInfo":{"status":"ok","timestamp":1790144238847,"user_tz":-120,"elapsed":1,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}}},"execution_count":24,"outputs":[]},{"cell_type":"markdown","source":["## 2- Select pre-fire and post-fire images\n","\n","Select two items from the STAC API search results (`items_kalteng`):\n","\n","1. `item_pre` = a date before the peak fire season (e.g., June/July 2023)\n","2. `item_post` = a date after or during the peak fire season (e.g., September/October 2023)"],"metadata":{"id":"ATRZnoyyPs8d"}},{"cell_type":"code","source":["for idx, item in enumerate(items_kalteng):\n","  print(f'index {idx} - date: {item.datetime.strftime(\"%Y-%m-%d\")} - cloud cover: {item.properties[\"eo:cloud_cover\"]:.2f}%')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HIPV3Pk5QJDP","executionInfo":{"status":"ok","timestamp":1790144238852,"user_tz":-120,"elapsed":4,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}},"outputId":"a96ca94f-6861-41d9-9bee-b8ccae63b0f5"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text