\n","    bbox=bbox_area,\n","    datetime=\"2026-01-01/2026-12-31\",\n","    query={\"eo:cloud_cover\": {\"lt\": 25}},\n",")\n","items_2026 = [\n","    it\n","    for it in search_2026_all.items()\n","    if it.properties.get(\"s2:mgrs_tile\") == target_tile\n","]\n","item_2026 = sorted(\n","    items_2026, key=lambda x: x.properties[\"eo:cloud_cover\"]\n",")[0]\n","\n","print(\n","    f\"-> Process Tile {target_tile} ({item_2016.datetime.strftime('%Y-%m-%d')} vs\"\n","    f\" {item_2026.datetime.strftime('%Y-%m-%d')})\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"70TQi7cbc2tj","executionInfo":{"status":"ok","timestamp":1790144889423,"user_tz":-120,"elapsed":1481,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}},"outputId":"610539e6-12ae-4dd8-d160-948270926cbf"},"execution_count":43,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/pystac_client/item_search.py:243: DoesNotConformTo: Server does not conform to QUERY\n","  warnings.warn(DoesNotConformTo(\"QUERY\"))\n"]},{"output_type":"stream","name":"stdout","text":["-> Process Tile 50MKB (2016-07-10 vs 2026-07-20)\n"]}]},{"cell_type":"code","source":["# NDVI Extractor (B08 & B04)\n","def get_ndvi_clean(item, bbox_target):\n","    url_nir = item.assets[\"B08\"].href\n","    url_red = item.assets[\"B04\"].href\n","\n","    nir = (\n","        rioxarray.open_rasterio(url_nir, masked=True)\n","        .rio.reproject(\"EPSG:4326\", resolution=0.0003, resampling=Resampling.bilinear)\n","        .squeeze()\n","    )\n","    red = (\n","        rioxarray.open_rasterio(url_red, masked=True)\n","        .rio.reproject(\"EPSG:4326\", resolution=0.0003, resampling=Resampling.bilinear)\n","        .squeeze()\n","    )\n","\n","    nir_sub = (\n","        nir.rio.clip_box(*bbox_target, crs=\"EPSG:4326\").load().astype(\"float32\")\n","    )\n","    red_sub = (\n","        red.rio.clip_box(*bbox_target, crs=\"EPSG:4326\").load().astype(\"float32\")\n","    )\n","\n","    # NDVI\n","    ndvi = (nir_sub - red_sub) / (nir_sub + red_sub)\n","    return ndvi.where((ndvi >= -1.0) & (ndvi <= 1.0))\n","\n","# Difference calculation:\n","# dNDVI = ndvi_2016 - ndvi_2026 (Positive values = Forest Loss)"],"metadata":{"id":"D5yL53CVUVI_","executionInfo":{"status":"ok","timestamp":1790144889423,"user_tz":-120,"elapsed":2,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}}},"execution_count":44,"outputs":[]},{"cell_type":"code","source":["# Extract NDVI & dNDVI difference\n","ndvi_2016 = get_ndvi_clean(item_2016, bbox_area)\n","ndvi_2026 = get_ndvi_clean(item_2026, bbox_area)\n","\n","ndvi_2026_aligned = ndvi_2026.interp_like(ndvi_2016)\n","dndvi = ndvi_2016 - ndvi_2026_aligned"],"metadata":{"id":"34MA9TsZXSQt","executionInfo":{"status":"ok","timestamp":1790144951179,"user_tz":-120,"elapsed":61755,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}}},"execution_count":45,"outputs":[]},{"cell_type":"code","source":["# Slice precise square coordinates matching the target area\n","ndvi_2016_crop = ndvi_2016.sel(\n","    x=slice(115.185, 115.295), y=slice(-2.712, -2.795)\n",")\n","ndvi_2026_crop = ndvi_2026_aligned.sel(\n","    x=slice(115.185, 115.295), y=slice(-2.712, -2.795)\n",")\n","\n","# Downsample to accelerate 3D rendering (step=3)\n","step = 3\n","ndvi_2016_sub = ndvi_2016_crop[::step, ::step]\n","ndvi_2026_sub = ndvi_2026_crop[::step, ::step]"],"metadata":{"id":"sM5ZPuarTDr8","executionInfo":{"status":"ok","timestamp":1790144951180,"user_tz":-120,"elapsed":3,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}}},"execution_count":46,"outputs":[]},{"cell_type":"markdown","source":["## 2- 3D Canopy Surface Rendering"],"metadata":{"id":"JBSpYyckTEaB"}},{"cell_type":"code","source":["# Create 2D Coordinate Meshgrid\n","X, Y = np.meshgrid(ndvi_2016_sub.x.values, ndvi_2016_sub.y.values)\n","\n","fig = plt.figure(figsize=(18, 8))\n","\n","# Left Panel: 2016\n","ax1 = fig.add_subplot(121, projection=\"3d\")\n","surf1 = ax1.plot_surface(\n","    X,\n","    Y,\n","    ndvi_2016_sub.values,\n","    cmap=\"YlGn\",\n","    vmin=0.0,\n","    vmax=0.8,\n","    linewidth=0,\n","    antialiased=True,\n",")\n","ax1.set_title(\n","    \"1. Tree Crown Topography (NDVI 2016)\\nDense Forest Condition\",\n","    fontsize=11,\n","    fontweight=\"bold\",\n",")\n","ax1.set_xlabel(\"Longitude\")\n","ax1.set_ylabel(\"Lat\")\n","ax1.set_zlabel(\"NDVI Value\")\n","ax1.view_init(elev=35, azim=-60)\n","fig.colorbar(surf1, ax=ax1, shrink=0.5, aspect=10)\n","\n","# Right Panel: 2026\n","ax2 = fig.add_subplot(122, projection=\"3d\")\n","surf2 = ax2.plot_surface(\n","    X,\n","    Y,\n","    ndvi_2026_sub.values,\n","    cmap=\"YlGn\",\n","    vmin=0.0,\n","    vmax=0.8,\n","    linewidth=0,\n","    antialiased=True,\n",")\n","ax2.set_title(\n","    \"2. Tree Crown Topography (NDVI 2026)\\nMassive Degradation and Deforestation\",\n","    fontsize=11,\n","    fontweight=\"bold\",\n",")\n","ax2.set_xlabel(\"Longitude\")\n","ax2.set_ylabel(\"Latitude\")\n","ax2.set_zlabel(\"NDVI Value\")\n","ax2.view_init(elev=35, azim=-60)\n","fig.colorbar(surf2, ax=ax2, shrink=0.5, aspect=10)\n","\n","plt.suptitle(\n","    \"3D Landscape Comparison: Canopy Loss in Central Kalimantan (2016 vs\"\n","    \" 2026)\",\n","    fontsize=14,\n","    fontweight=\"bold\",\n","    y= 1.00,\n",")\n","plt.tight_layout()\n","\n","# Save the plot in high resolution (300 DPI)\n","plt.savefig(\"NDVI_3D_Landscape_Kalteng.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# Statistical Calculation of Canopy Loss Area\n","dndvi_crop = ndvi_2016_crop - ndvi_2026_crop\n","total_pixels = np.count_nonzero(~np.isnan(dndvi_crop.values))\n","deforested_pixels = np.count_nonzero(dndvi_crop.values > 0.25)\n","pct_deforested = (deforested_pixels / total_pixels) * 100\n","\n","print(\"DEFORESTATION STATISTICAL ANALYSIS RESULTS (2016 - 2026)\")\n","\n","print(f\"- Total sample area analyzed : {total_pixels:,} pixel\")\n","print(\n","    \"- Deforestation hotspot (ΔNDVI > 0.25) :\"\n","    f\" {deforested_pixels:,} pixel\"\n",")\n","print(f\"- Percentage of forest degradation : {pct_deforested:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":438},"id":"PH2sk2JYm_NK","executionInfo":{"status":"ok","timestamp":1790144956689,"user_tz":-120,"elapsed":5509,"user":{"displayName":"Hana Z. Hanifah","userId":"08843947618547841173"}},"outputId":"3f6c5fca-f47d-4575-d809-063c743047b5"},"execution_count":47,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x800 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["DEFORESTATION STATISTICAL ANALYSIS RESULTS (2016 - 2026)\n","- Total sample area analyzed : 94,804 pixel\n","- Deforestation hotspot (ΔNDVI > 0.25) : 50,840 pixel\n","- Percentage of forest degradation : 53.63%\n"]}]},{"cell_type":"markdown","source":["## 3- Deforestation Statistical Breakdown (53.63%)\n","\n","A transect profile graph at latitude $-2.78^\\circ$ S showing a decline in NDVI values from a dense forest condition (2016) to a deforested condition (2026).   "],"metadata":{"id":"yNeMFSOuS5PL"}},{"cell_type":"code","source":["# Retrieve Latitude coordinate specifically (Lat = -2.78)\n","lat_target = -2.78\n","line_2016 = ndvi_2016_crop.sel(y=lat_target, method=\"nearest\")\n","line_2026 = ndvi_2026_crop.sel(y=lat_target, method=\"nearest\")\n","\n","# 2D Cross-Section Plot\n","plt.figure(figsize=(10, 4))\n","plt.plot(\n","    line_2016.x,\n","    line_2016.values,\n","    label=\"2016 (Dense Forest Condition)\",\n","    color=\"green\",\n","    linewidth=2,\n",")\n","plt.plot(\n","    line_2026.x,\n","    line_2026.values,\n","    label=\"2026 (Deforestation)\",\n","    color=\"orange\",\n","    linewidth=2,\n",")\n","\n","# Min range\n","plt.axhline(\n","    y=0.2,\n","    color=\"red\",\n","    linestyle=\"--\",\n","    